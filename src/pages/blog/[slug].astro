---
import Layout from '../../layouts/Layout.astro';
import BlockRenderer from '../../components/BlockRenderer.astro';

const modules = import.meta.glob('/src/content/blog/*.mdx', { eager: true });

export function getStaticPaths() {
  const mods = import.meta.glob('/src/content/blog/*.mdx', { eager: true });
  return Object.keys(mods).map(path => {
    const slug = path.split('/').pop().replace('.mdx', '');
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
const key = `/src/content/blog/${slug}.mdx`;
const mod = modules[key];
if (!mod) {
  return Astro.redirect('/blog');
}
const { frontmatter } = mod;
const Post = mod.default;
---

<Layout title={frontmatter.title}>
  <article class="section">
    <div class="wrap max-w-[960px] mx-auto">
      <div class="mb-10">
        {frontmatter.eyebrow && <span class="eyebrow">{frontmatter.eyebrow}</span>}
        <h1 class="font-display text-[2.4rem] md:text-[3.25rem] font-extrabold leading-[1.05] tracking-[-0.03em] mt-2 mb-4">{frontmatter.title}</h1>
        <div class="flex items-center gap-4 text-[14px] text-ink/50 dark:text-ink-dark/50 font-ui">
          <span>{frontmatter.date}</span>
        </div>
      </div>
      <div class="prose max-w-none">
        {frontmatter.blocks ? <BlockRenderer blocks={frontmatter.blocks} /> : <Post />}
      </div>
    </div>
  </article>
</Layout>
