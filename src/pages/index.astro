---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../consts";

const modules = import.meta.glob('/src/content/blog/*.mdx', { eager: true });
const posts = Object.entries(modules).map(([path, mod]) => {
  const slug = path.split('/').pop().replace('.mdx', '');
  return { slug, ...(mod.frontmatter ?? {}) };
}).filter(p => !p.draft).sort((a, b) => (a.date ?? '') < (b.date ?? '') ? 1 : -1);
---
<Layout>
  <!-- Hero -->
  <section class="pt-16 pb-14 md:pt-24 md:pb-20">
    <div class="wrap grid md:grid-cols-[1.15fr_0.85fr] gap-x-16 gap-y-12 items-center">
      <div>
        <span class="eyebrow">{SITE.role}</span>
        <h1 class="font-display text-[2.9rem] md:text-[4rem] font-extrabold leading-[1.02] tracking-[-0.03em] mb-6 text-balance">{SITE.tagline}</h1>
        <p class="font-body text-[1.15rem] md:text-[1.3rem] text-ink/85 dark:text-ink-dark/80 leading-[1.65] max-w-[620px]">
          I partner with product teams across automotive, fintech, and aerospace to turn delivery into a rhythm — measurable outcomes, a cadence you can plan around, and change that sticks.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/blog" class="btn-primary">View my work</a>
          <a href="/about" class="btn-ghost">About me</a>
        </div>
      </div>

      <!-- Signature: a live "program health" panel — her actual instrument -->
      <div class="card p-7 md:p-8">
        <div class="flex items-center justify-between">
          <span class="font-ui text-[12px] font-semibold uppercase tracking-[.14em] text-ink/45 dark:text-ink-dark/50">Current program</span>
          <span class="inline-flex items-center gap-1.5 font-ui text-[12px] font-medium text-accent dark:text-accent-dark">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full rounded-full bg-accent/60 dark:bg-accent-dark/60 animate-ping"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent dark:bg-accent-dark"></span>
            </span>
            On track
          </span>
        </div>

        <!-- Cadence bar — each segment is a sprint in the increment -->
        <div class="mt-6 flex items-center gap-1.5" aria-hidden="true">
          <span class="h-2.5 flex-1 rounded-full bg-accent dark:bg-accent-dark"></span>
          <span class="h-2.5 flex-1 rounded-full bg-accent dark:bg-accent-dark"></span>
          <span class="h-2.5 flex-1 rounded-full bg-accent dark:bg-accent-dark"></span>
          <span class="h-2.5 flex-1 rounded-full bg-accent/40 dark:bg-accent-dark/40"></span>
          <span class="h-2.5 flex-1 rounded-full bg-ink/10 dark:bg-ink-dark/15"></span>
          <span class="h-2.5 flex-1 rounded-full bg-ink/10 dark:bg-ink-dark/15"></span>
        </div>
        <div class="mt-2 flex justify-between font-ui text-[11px] text-ink/40 dark:text-ink-dark/45">
          <span>PI start</span>
          <span>Sprint 4 of 6</span>
        </div>

        <!-- Metrics -->
        <div class="mt-7 grid grid-cols-3 gap-4 border-t border-ink/[.08] dark:border-ink-dark/[.08] pt-6">
          <div>
            <div class="font-display text-[1.9rem] font-bold leading-none text-accent dark:text-accent-dark">9</div>
            <div class="font-ui text-[12px] text-ink/50 dark:text-ink-dark/55 mt-1.5">teams in ART</div>
          </div>
          <div>
            <div class="font-display text-[1.9rem] font-bold leading-none text-accent dark:text-accent-dark">50+</div>
            <div class="font-ui text-[12px] text-ink/50 dark:text-ink-dark/55 mt-1.5">people aligned</div>
          </div>
          <div>
            <div class="font-display text-[1.9rem] font-bold leading-none text-accent dark:text-accent-dark">9+</div>
            <div class="font-ui text-[12px] text-ink/50 dark:text-ink-dark/55 mt-1.5">yrs leading</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cadence divider — the rhythm carries through the page -->
  <div class="wrap"><div class="cadence" aria-hidden="true"></div></div>

  <!-- Selected work -->
  <section class="section">
    <div class="wrap">
      <div class="flex items-end justify-between mb-12">
        <div>
          <span class="eyebrow">Selected work</span>
          <h2 class="font-display text-[1.9rem] md:text-[2.5rem] font-bold tracking-[-0.02em] leading-[1.1]">Case studies with outcomes</h2>
        </div>
        <a href="/blog" class="font-ui text-[13px] font-medium text-accent dark:text-accent-dark hover:underline underline-offset-2 hidden md:inline-block shrink-0 ml-6">View all →</a>
      </div>
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group card p-6 md:p-8 flex flex-col justify-between">
            <div>
              {post.eyebrow && <span class="font-ui text-[11px] font-semibold text-accent dark:text-accent-dark uppercase tracking-[.12em]">{post.eyebrow}</span>}
              <h3 class="font-display text-[1.25rem] font-semibold leading-snug mt-3 mb-3 group-hover:text-accent dark:group-hover:text-accent-dark transition-colors duration-200">{post.title}</h3>
              <p class="font-body text-[.98rem] text-ink/60 dark:text-ink-dark/65 leading-relaxed">{post.description ?? ''}</p>
            </div>
            <div class="mt-6 pt-4 border-t border-ink/[.06] dark:border-ink-dark/[.08] flex items-center justify-between font-ui text-[12px] text-ink/40 dark:text-ink-dark/45">
              <span>{post.date}</span>
              <span class="opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0 transition-all duration-200 text-accent dark:text-accent-dark">Read →</span>
            </div>
          </a>
        ))}
      </div>
      <a href="/blog" class="block md:hidden text-center mt-8 font-ui text-[13px] font-medium text-accent dark:text-accent-dark">View all work →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-24">
    <div class="wrap">
      <div class="relative overflow-hidden rounded-[24px] bg-ink dark:bg-card-dark border border-ink dark:border-ink-dark/10 px-8 py-14 md:px-16 md:py-16">
        <!-- faint cadence echo -->
        <div class="absolute inset-x-0 top-0 h-2.5 opacity-[.14]" aria-hidden="true"
             style="background: repeating-linear-gradient(90deg,#e8ece9 0 1.5px, transparent 1.5px 32px);"></div>
        <div class="md:flex md:items-center md:justify-between md:gap-10">
          <div class="max-w-xl">
            <h2 class="font-display text-[1.7rem] md:text-[2.2rem] font-bold text-pagebg dark:text-ink-dark leading-tight mb-3">Let's get your delivery on track</h2>
            <p class="font-body text-[1.05rem] text-pagebg/60 dark:text-ink-dark/60">Looking for a Scrum Master or Release Train Engineer who leaves teams running better than they found them? I'm open to new opportunities.</p>
          </div>
          <a href="mailto:ananyarao121996@gmail.com" class="btn-accent mt-7 md:mt-0 shrink-0">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
