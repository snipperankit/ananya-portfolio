---
import Layout from "../layouts/Layout.astro";
import BlockRenderer from "../components/BlockRenderer.astro";

const AboutModule = await import("../content/about.mdx");
const fm = AboutModule.frontmatter ?? {};
---

<Layout title="About">
  <section class="section">
    <div class="wrap">
      <div class="grid md:grid-cols-[300px_1fr] gap-12 items-start">
        <!-- Sidebar -->
        <aside class="md:sticky md:top-24">
          <div class="bg-ink dark:bg-card-dark rounded-2xl p-8 border border-ink dark:border-ink-dark/10">
            <div class="w-16 h-16 rounded-2xl bg-accent/20 flex items-center justify-center text-white font-display font-bold text-xl mb-5">AR</div>
            <h2 class="font-display text-[1.5rem] font-bold leading-tight text-white dark:text-ink-dark">Ananya Rao</h2>
            <p class="font-ui text-[16px] text-white/70 dark:text-ink-dark/70 mt-2">Release Train Engineer &amp; Scrum Master</p>

            <div class="mt-7 space-y-4 font-ui text-[15px]">
              <div>
                <div class="text-white/40 dark:text-ink-dark/40 text-[12px] uppercase tracking-[.1em] mb-1">Based in</div>
                <div class="text-white/90 dark:text-ink-dark/90">Ulm, Germany</div>
              </div>
              <div>
                <div class="text-white/40 dark:text-ink-dark/40 text-[12px] uppercase tracking-[.1em] mb-1">Languages</div>
                <div class="text-white/90 dark:text-ink-dark/90">German B2 · English C1</div>
              </div>
            </div>

            <div class="mt-7 pt-6 border-t border-white/10 dark:border-ink-dark/10">
              <span class="font-ui text-[12px] font-semibold uppercase tracking-[.12em] text-white/40 dark:text-ink-dark/45">Certified</span>
              <div class="mt-3 flex flex-wrap gap-2">
                {["SAFe 6", "PMP", "CAPM"].map(c => (
                  <span class="font-ui text-[14px] bg-accent/20 text-accent-dark px-3 py-1.5 rounded-full">{c}</span>
                ))}
              </div>
            </div>

            <a href="mailto:ananyarao121996@gmail.com" class="btn-accent w-full text-center mt-7">Contact me</a>
          </div>
        </aside>

        <!-- Main content -->
        <div class="prose max-w-none">
          <BlockRenderer blocks={fm.blocks ?? []} />
        </div>
      </div>
    </div>
  </section>
</Layout>
