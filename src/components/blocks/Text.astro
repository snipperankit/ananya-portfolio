---
import { marked } from 'marked';
const { block } = Astro.props;
const alignClass = block.align === 'center' ? 'text-center' : block.align === 'right' ? 'text-right' : '';
const html = block.text ? marked.parse(block.text) : '';
---
<div class={`text-lg md:text-xl leading-relaxed text-ink/80 dark:text-ink-dark/85 mb-5 ${alignClass}`} set:html={html} />
