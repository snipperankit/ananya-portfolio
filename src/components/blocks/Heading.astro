---
const { block } = Astro.props;
const level = Math.min(Math.max(block.level ?? 1, 1), 3);
const Tag = `h${level}`;
const alignClass = block.align === 'center' ? 'text-center' : block.align === 'right' ? 'text-right' : '';
const sizes = { 1: 'text-[2.4rem] md:text-[3.25rem] font-extrabold tracking-[-0.03em]', 2: 'text-[1.7rem] md:text-[2.1rem] font-bold tracking-[-0.02em]', 3: 'text-xl md:text-2xl font-semibold' };
---
<Tag class={`font-display ${sizes[level]} leading-[1.1] mt-8 mb-4 ${alignClass}`}>{block.text}</Tag>
