---
// Landing page — design "1a Broadsheet": centered masthead, ruled sections.
import type { Lang } from "../../i18n";
import { t, localizePath } from "../../i18n";
import { certifications } from "../../data/profile";


interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang).home;

const modules = import.meta.glob('/src/content/blog/*.mdx', { eager: true });
const posts = Object.entries(modules).map(([path, mod]: [string, any]) => {
  const slug = path.split('/').pop().replace('.mdx', '');
  return { slug, ...(mod.frontmatter ?? {}) };
}).filter((p: any) => !p.draft).sort((a: any, b: any) => (a.date ?? '') < (b.date ?? '') ? 1 : -1);

const fmtDate = (d: string) => String(d).slice(0, 10);

// All certs rendered uniformly, already sorted descending in profile.ts
---
<!-- Hero — centered masthead -->
<section class="pt-32 pb-14 md:pt-44 md:pb-16 border-b border-ink/15 dark:border-ink-dark/15">
  <div class="wrap text-center max-w-[800px] mx-auto px-6">
    <div class="font-ui text-[14px] md:text-[16px] font-bold uppercase tracking-[.28em] text-ink dark:text-ink-dark mb-7">{tr.eyebrow}</div>
    <h1 class="font-display font-normal text-[2.4rem] md:text-[3.2rem] lg:text-[3.6rem] leading-[1.1] tracking-[-0.018em] mb-6">
      {tr.headline}
    </h1>
    <div class="mt-9 flex flex-wrap justify-center gap-3.5">
      <a href={localizePath(lang, "/blog")} class="font-ui text-[11px] font-medium uppercase tracking-[.18em] px-7 py-4 bg-ink dark:bg-ink-dark text-pagebg dark:text-pagebg-dark border border-ink dark:border-ink-dark hover:opacity-80 transition-opacity">{tr.btnCaseStudies}</a>
      <a href={localizePath(lang, "/work")} class="font-ui text-[11px] font-medium uppercase tracking-[.18em] px-7 py-4 text-ink dark:text-ink-dark border border-ink/20 dark:border-ink-dark/25 hover:border-ink dark:hover:border-ink-dark transition-colors">{tr.btnInsights}</a>
    </div>
    <!-- perforation rule -->
    <div class="mt-12 h-2 bg-ink/15 dark:bg-ink-dark/15" style="-webkit-mask:repeating-linear-gradient(90deg,#000 0 1.5px,transparent 1.5px 30px);mask:repeating-linear-gradient(90deg,#000 0 1.5px,transparent 1.5px 30px);"></div>
  </div>
</section>

<!-- Stats row -->
<section class="border-b border-ink/15 dark:border-ink-dark/15">
  <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-ink/15 dark:divide-ink-dark/15">
    <div class="flex flex-col items-center justify-center py-12 px-4">
      <div class="font-display text-[3.4rem] md:text-[4rem] leading-none">{tr.statYearsValue}</div>
      <div class="font-ui text-[12px] md:text-[13px] uppercase tracking-[.18em] text-ink dark:text-ink-dark mt-4">{tr.statYearsLabel}</div>
    </div>
    <div class="flex flex-col items-center justify-center py-12 px-4">
      <div class="font-display text-[3.4rem] md:text-[4rem] leading-none">{tr.statArtValue}</div>
      <div class="font-ui text-[12px] md:text-[13px] uppercase tracking-[.18em] text-ink dark:text-ink-dark mt-4">{tr.statArtLabel}</div>
    </div>
    <div class="flex flex-col items-center justify-center py-12 px-4">
      <div class="flex items-center justify-center gap-4 md:gap-6">
        <img src="/logos/revolut.png" alt="Revolut logo" class="h-8 md:h-10 w-auto object-contain" />
        <img src="/logos/mercedes-benz.png" alt="Mercedes-Benz logo" class="h-8 md:h-10 w-auto object-contain" />
        <img src="/logos/toyota.png" alt="Toyota logo" class="h-8 md:h-10 w-auto object-contain" />
      </div>
      <div class="font-ui text-[12px] md:text-[13px] uppercase tracking-[.18em] text-ink dark:text-ink-dark mt-4">{tr.statCustomersLabel}</div>
    </div>
  </div>
</section>

<!-- Professional Certifications -->
<section class="border-b border-ink/15 dark:border-ink-dark/15">
  <div class="wrap py-14 md:py-16">
    <h2 class="font-ui text-[13px] font-semibold uppercase tracking-[.3em] text-ink/45 dark:text-ink-dark/45 text-center mb-3">{tr.certsLabel}</h2>
    <p class="font-body text-[1rem] text-ink/50 dark:text-ink-dark/50 text-center mb-10">Industry-recognized credentials validating expertise in agile, project management, and AI.</p>
    <div class="flex flex-wrap justify-center gap-5">
      {certifications.map(c => (
        <article class="bg-card dark:bg-card-dark border border-ink/10 dark:border-ink-dark/10 rounded-xl p-6 w-full sm:w-[calc(50%-0.625rem)] lg:w-[calc(33.333%-0.875rem)] hover:border-ink/25 dark:hover:border-ink-dark/25 hover:shadow-md transition-all duration-200">
          <div class="flex items-start gap-4">
            <img src={c.logo} alt={`${c.name[lang]} certification badge`} class="w-16 h-16 shrink-0 rounded-lg object-contain" />
            <div class="min-w-0">
              <h3 class="font-display text-[1.05rem] md:text-[1.1rem] leading-snug text-ink dark:text-ink-dark">{c.name[lang]}</h3>
              <p class="font-ui text-[12px] uppercase tracking-[.12em] text-ink/50 dark:text-ink-dark/50 mt-2">{c.issuer} · {c.year}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Selected work -->
<section>
  <div class="wrap py-16 md:py-20">
    <div class="text-center mb-10">
      <div class="font-ui text-[11px] font-semibold uppercase tracking-[.34em] text-muted dark:text-muted-dark mb-4">{tr.selectedEyebrow}</div>
      <h2 class="font-display font-normal text-[1.9rem] md:text-[2.2rem] tracking-[-0.015em]">{tr.selectedTitle}</h2>
    </div>
    <div class="border-b border-ink/15 dark:border-ink-dark/15">
      {posts.map((post: any, i: number) => (
        <a href={`/blog/${post.slug}`} class="group grid grid-cols-[auto_1fr] md:grid-cols-[56px_1fr_130px] gap-x-6 md:gap-x-8 py-7 items-start border-t border-ink/15 dark:border-ink-dark/15 hover:bg-card dark:hover:bg-card-dark transition-colors px-2">
          <span class="font-display text-[1.5rem] text-muted dark:text-muted-dark leading-none">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="font-display font-normal text-[1.2rem] md:text-[1.3rem] leading-[1.25] tracking-[-0.01em] group-hover:text-accent dark:group-hover:text-accent-dark transition-colors duration-200">{post.title}</h3>
            <p class="font-body text-[.95rem] text-muted dark:text-muted-dark leading-[1.6] mt-2 max-w-[500px]">{post.description ?? ''}</p>
          </div>
          <div class="text-right hidden md:block font-ui text-[10px] uppercase tracking-[.18em] text-muted dark:text-muted-dark">
            <span class="block mb-2.5">{fmtDate(post.date)}</span>
            <span class="block text-ink dark:text-ink-dark opacity-0 group-hover:opacity-100 transition-opacity duration-200">{tr.read}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CTA — inverted band -->
<section class="bg-ink dark:bg-card-dark text-pagebg dark:text-ink-dark">
  <div class="wrap text-center max-w-[640px] mx-auto py-16 md:py-20 px-6">
    <h2 class="font-display font-normal text-[1.9rem] md:text-[2.3rem] tracking-[-0.015em] mb-4">{tr.ctaTitle}</h2>
    <p class="font-body text-[1.02rem] leading-[1.7] opacity-70 mb-8 max-w-[440px] mx-auto">{tr.ctaBody}</p>
    <button data-contact-trigger class="font-ui text-[11px] font-medium uppercase tracking-[.18em] px-8 py-4 bg-pagebg dark:bg-ink-dark text-ink dark:text-pagebg-dark hover:opacity-85 transition-opacity cursor-pointer">{tr.ctaButton}</button>
  </div>
</section>
