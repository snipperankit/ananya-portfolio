---
// About page — verbose intro, work/education timelines, stacked certifications.
import type { Lang } from "../../i18n";
import { t } from "../../i18n";
import { aboutIntro, experience, education, certifications } from "../../data/profile";

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang).about;

// Descending: newest first.
const certsDescending = [...certifications].sort((a, b) => b.year - a.year);
---
<section class="section pt-32">
  <div class="wrap">
    <div class="grid md:grid-cols-[280px_1fr] gap-16 items-start">
      <!-- Sidebar -->
      <aside class="md:sticky md:top-24">
        <div class="bg-ink dark:bg-card-dark p-8 border border-ink dark:border-ink-dark/10">
          <div class="w-14 h-14 bg-accent/25 flex items-center justify-center text-pagebg font-display font-semibold text-lg mb-5">AR</div>
          <h2 class="font-display text-[1.4rem] font-semibold leading-tight text-pagebg dark:text-ink-dark">Ananya Rao</h2>
          <p class="font-ui text-[12px] text-pagebg/60 dark:text-ink-dark/60 mt-2">{tr.role}</p>

          <div class="mt-7 space-y-4 font-ui text-[13px]">
            <div>
              <div class="text-pagebg/35 dark:text-ink-dark/35 text-[10px] uppercase tracking-[.14em] mb-1">{tr.visaLabel}</div>
              <div class="text-pagebg/85 dark:text-ink-dark/85">{tr.visaValue}</div>
            </div>
            <div>
              <div class="text-pagebg/35 dark:text-ink-dark/35 text-[10px] uppercase tracking-[.14em] mb-1">{tr.languagesLabel}</div>
              <div class="text-pagebg/85 dark:text-ink-dark/85">{tr.languagesValue}</div>
            </div>
            <div>
              <div class="text-pagebg/35 dark:text-ink-dark/35 text-[10px] uppercase tracking-[.14em] mb-1">{tr.basedIn}</div>
              <div class="text-pagebg/85 dark:text-ink-dark/85">{tr.basedInValue}</div>
            </div>
          </div>

          <div class="mt-7 pt-6 border-t border-pagebg/10 dark:border-ink-dark/10">
            <span class="font-ui text-[10px] font-semibold uppercase tracking-[.14em] text-pagebg/35 dark:text-ink-dark/35">{tr.certifiedLabel}</span>
            <div class="mt-3 flex flex-wrap gap-2">
              {["PMP", "SAFe 6 CSM", "CAPM", "FMEA"].map(c => (
                <span class="font-ui text-[12px] bg-pagebg/10 text-pagebg/80 dark:text-ink-dark/80 px-3 py-1.5">{c}</span>
              ))}
            </div>
          </div>
        </div>
      </aside>

      <!-- Main content -->
      <div>
        <h1 class="font-display font-normal text-[2.2rem] md:text-[2.8rem] leading-[1.1] tracking-[-0.018em] mb-8">{tr.title}</h1>
        <div class="space-y-6">
          {aboutIntro[lang].map(p => (
            <p class="font-body text-[1.15rem] md:text-[1.2rem] leading-[1.8] text-ink/80 dark:text-ink-dark/80">{p}</p>
          ))}
        </div>

        <!-- Work experience timeline -->
        <h2 class="font-display font-normal text-[1.7rem] md:text-[2rem] tracking-[-0.01em] mt-16 mb-8 pb-4 border-b border-ink/15 dark:border-ink-dark/15">{tr.experienceTitle}</h2>
        <ol class="relative border-l border-ink/20 dark:border-ink-dark/20 ml-1.5 space-y-12">
          {experience.map(job => (
            <li class="relative pl-8">
              <span class="absolute -left-[5px] top-2 w-[9px] h-[9px] rounded-full bg-accent dark:bg-accent-dark"></span>
              <div class="font-ui text-[12px] font-semibold uppercase tracking-[.2em] text-accent dark:text-accent-dark mb-2">{job.period[lang]}</div>
              <h3 class="font-display font-normal text-[1.4rem] md:text-[1.5rem] leading-snug">{job.role[lang]}</h3>
              <div class="font-ui text-[13px] text-ink/70 dark:text-ink-dark/70 mt-1">{job.company} · {job.location[lang]}</div>
              <p class="font-body text-[1.1rem] md:text-[1.15rem] leading-[1.7] text-ink/85 dark:text-ink-dark/85 mt-3">{job.summary[lang]}</p>
              {job.highlights.length > 0 && (
                <ul class="mt-3 space-y-2">
                  {job.highlights.map(h => (
                    <li class="font-body text-[1.05rem] md:text-[1.1rem] leading-[1.65] text-ink/75 dark:text-ink-dark/75 pl-4 relative before:content-['—'] before:absolute before:left-0 before:text-accent dark:before:text-accent-dark">{h[lang]}</li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>

        <!-- Education timeline -->
        <h2 class="font-display font-normal text-[1.7rem] md:text-[2rem] tracking-[-0.01em] mt-16 mb-8 pb-4 border-b border-ink/15 dark:border-ink-dark/15">{tr.educationTitle}</h2>
        <ol class="relative border-l border-ink/20 dark:border-ink-dark/20 ml-1.5 space-y-10">
          {education.map(edu => (
            <li class="relative pl-8">
              <span class="absolute -left-[5px] top-2 w-[9px] h-[9px] rounded-full bg-accent dark:bg-accent-dark"></span>
              <div class="font-ui text-[12px] font-semibold uppercase tracking-[.2em] text-accent dark:text-accent-dark mb-2">{edu.period[lang]}</div>
              <h3 class="font-display font-normal text-[1.4rem] md:text-[1.5rem] leading-snug">{edu.degree[lang]}</h3>
              <div class="font-ui text-[13px] text-ink/70 dark:text-ink-dark/70 mt-1">{edu.school} · {edu.location[lang]}</div>
              <p class="font-body text-[1.05rem] md:text-[1.1rem] leading-[1.65] text-ink/80 dark:text-ink-dark/80 mt-2">{edu.note[lang]}</p>
            </li>
          ))}
        </ol>

        <!-- Certifications — descending, stacked -->
        <h2 class="font-display font-normal text-[1.7rem] md:text-[2rem] tracking-[-0.01em] mt-16 mb-2 pb-4 border-b border-ink/15 dark:border-ink-dark/15">{tr.certificationsTitle}</h2>
        <p class="font-ui text-[11px] uppercase tracking-[.18em] text-muted dark:text-muted-dark mb-6">{tr.certificationsHint}</p>
        <div class="divide-y divide-ink/15 dark:divide-ink-dark/15 border-b border-ink/15 dark:border-ink-dark/15">
          {certsDescending.map(c => (
            <div class="flex items-center gap-5 py-5">
              <span class="font-display text-[1.4rem] text-muted dark:text-muted-dark w-[64px] flex-none">{c.year}</span>
              <img src={c.logo} alt={c.issuer} class="w-10 h-10 flex-none rounded-lg object-contain" />
              <span>
                <span class="block font-display text-[1.1rem] leading-tight">{c.name[lang]}</span>
                <span class="block font-ui text-[11px] uppercase tracking-[.14em] text-muted dark:text-muted-dark mt-1">{c.issuer}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
