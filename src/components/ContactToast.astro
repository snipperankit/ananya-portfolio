---
// Toast opened by any element carrying [data-contact-trigger].
import type { Lang } from "../i18n";
import { t } from "../i18n";
import { CONTACT } from "../data/profile";

interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const tr = t(lang).contactToast;
---
<div
  id="contact-toast"
  role="dialog"
  aria-modal="false"
  aria-labelledby="contact-toast-title"
  class="fixed bottom-6 right-6 z-[100] w-[320px] max-w-[calc(100vw-3rem)] bg-ink dark:bg-card-dark text-pagebg dark:text-ink-dark border border-pagebg/15 dark:border-ink-dark/15 shadow-2xl p-6 translate-y-4 opacity-0 pointer-events-none transition-all duration-300"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <div id="contact-toast-title" class="font-display text-[1.2rem] leading-tight">{tr.title}</div>
      <p class="font-ui text-[12px] text-pagebg/60 dark:text-ink-dark/60 mt-1">{tr.body}</p>
    </div>
    <button
      id="contact-toast-close"
      aria-label={tr.close}
      class="font-ui text-[14px] leading-none text-pagebg/60 dark:text-ink-dark/60 hover:text-pagebg dark:hover:text-ink-dark p-1 -m-1"
    >✕</button>
  </div>
  <div class="mt-4 space-y-2">
    <a
      href={CONTACT.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-3 border border-pagebg/20 dark:border-ink-dark/20 px-4 py-3 hover:border-pagebg dark:hover:border-ink-dark transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
      <span class="font-ui text-[11px] font-semibold uppercase tracking-[.12em]">LinkedIn</span>
    </a>
    <a
      href={`mailto:${CONTACT.email}`}
      class="flex items-center gap-3 border border-pagebg/20 dark:border-ink-dark/20 px-4 py-3 hover:border-pagebg dark:hover:border-ink-dark transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="1.5"/><path d="m3 6 9 7 9-7"/></svg>
      <span class="font-ui text-[11px] tracking-[.02em] break-all">{CONTACT.email}</span>
    </a>
  </div>
</div>

<script is:inline>
  (function () {
    const toast = document.getElementById('contact-toast');
    if (!toast) return;
    const open = () => {
      toast.classList.remove('translate-y-4', 'opacity-0', 'pointer-events-none');
    };
    const close = () => {
      toast.classList.add('translate-y-4', 'opacity-0', 'pointer-events-none');
    };
    document.querySelectorAll('[data-contact-trigger]').forEach((el) => {
      el.addEventListener('click', (e) => { e.preventDefault(); open(); });
    });
    document.getElementById('contact-toast-close').addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    document.addEventListener('click', (e) => {
      if (!toast.contains(e.target) && !e.target.closest('[data-contact-trigger]')) close();
    });
  })();
</script>
