---
import { SITE } from "../consts";
import type { Lang } from "../i18n";
import { t, localizePath } from "../i18n";

interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const tr = t(lang);

const nav = [
  { label: tr.nav.about, href: localizePath(lang, "/about") },
  { label: tr.nav.caseStudies, href: localizePath(lang, "/blog") },
];

// Equivalent page in the other language; detail pages fall back to their
// section index, unknown paths to home.
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const basePath = lang === "de" ? (pathname.replace(/^\/de/, "") || "/") : pathname;
const localizedRoots = ["/", "/blog", "/work", "/about", "/impressum"];
const switchBase = localizedRoots.includes(basePath)
  ? basePath
  : localizedRoots.find((r) => r !== "/" && basePath.startsWith(r)) ?? "/";
const switchHref = lang === "de" ? switchBase : localizePath("de", switchBase);
---
<header class="fixed top-0 left-0 right-0 z-50 bg-pagebg/90 dark:bg-pagebg-dark/90 backdrop-blur-md border-b border-ink/15 dark:border-ink-dark/15">
  <div class="wrap flex items-center justify-between h-[72px]">
    <a href={localizePath(lang, "/")} class="font-display font-semibold text-[1.4rem] text-ink dark:text-ink-dark leading-tight hover:opacity-70 transition-opacity">{SITE.name}</a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1">
      {nav.map(item => (
        <a href={item.href} class="font-ui text-[13px] font-medium uppercase tracking-[.16em] text-muted dark:text-muted-dark px-3 py-2 hover:text-ink dark:hover:text-ink-dark transition-colors duration-150">{item.label}</a>
      ))}
      <button data-contact-trigger class="font-ui text-[13px] font-medium uppercase tracking-[.16em] text-muted dark:text-muted-dark px-3 py-2 hover:text-ink dark:hover:text-ink-dark transition-colors duration-150 cursor-pointer">{tr.nav.contact}</button>
      <a href={switchHref} class="font-ui text-[13px] font-medium uppercase tracking-[.16em] border border-ink/20 dark:border-ink-dark/25 text-ink dark:text-ink-dark px-3 py-2 ml-2 hover:border-ink dark:hover:border-ink-dark transition-colors duration-150" aria-label={lang === "de" ? "Switch to English" : "Zu Deutsch wechseln"}>
        {lang === "de" ? "EN" : "DE"}
      </a>
      <button id="theme-toggle" class="ml-2 p-2 hover:opacity-70 transition-opacity" aria-label="Toggle theme">
        <svg class="w-5 h-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/></svg>
        <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>
    </nav>

    <!-- Mobile: lang + theme + hamburger -->
    <div class="flex md:hidden items-center gap-1">
      <a href={switchHref} class="font-ui text-[13px] font-medium uppercase tracking-[.16em] border border-ink/20 dark:border-ink-dark/25 text-ink dark:text-ink-dark px-2.5 py-1.5 hover:border-ink dark:hover:border-ink-dark transition-colors duration-150" aria-label={lang === "de" ? "Switch to English" : "Zu Deutsch wechseln"}>
        {lang === "de" ? "EN" : "DE"}
      </a>
      <button id="theme-toggle-mobile" class="p-2 hover:opacity-70 transition-opacity" aria-label="Toggle theme">
        <svg class="w-5 h-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/></svg>
        <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>
      <button id="mobile-menu-btn" class="p-2 hover:opacity-70 transition-opacity" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-ink/15 dark:border-ink-dark/15 bg-pagebg dark:bg-pagebg-dark">
    <div class="wrap py-4 flex flex-col gap-1">
      {nav.map(item => (
        <a href={item.href} class="font-ui text-[14px] font-medium uppercase tracking-[.14em] text-ink dark:text-ink-dark px-2 py-3 hover:text-accent dark:hover:text-accent-dark transition-colors">{item.label}</a>
      ))}
      <button data-contact-trigger class="font-ui text-[14px] font-medium uppercase tracking-[.14em] text-ink dark:text-ink-dark px-2 py-3 hover:text-accent dark:hover:text-accent-dark transition-colors text-left cursor-pointer">{tr.nav.contact}</button>
    </div>
  </div>
</header>
<script is:inline>
  function toggleTheme() {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
  }
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
  document.getElementById('mobile-menu-btn')?.addEventListener('click', function() {
    document.getElementById('mobile-menu').classList.toggle('hidden');
  });
</script>
