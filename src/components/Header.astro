---
import { SITE } from "../consts";
---
<header class="sticky top-0 z-50 bg-pagebg/80 dark:bg-pagebg-dark/80 backdrop-blur-xl border-b border-ink/[.04] dark:border-ink-dark/[.06]">
  <div class="wrap flex items-center justify-between h-[72px]">
    <a href="/" class="group flex items-center gap-3">
      <span class="w-10 h-10 rounded-full bg-ink dark:bg-ink-dark flex items-center justify-center text-pagebg dark:text-pagebg-dark font-ui font-semibold text-[14px] group-hover:scale-105 transition-transform duration-200">AR</span>
      <span class="font-display font-semibold text-ink dark:text-ink-dark text-[18px] tracking-[-0.01em] hidden sm:inline">{SITE.name}</span>
    </a>
    <nav class="flex items-center gap-2">
      <a href="/blog" class="font-ui text-[16px] font-medium text-ink/70 dark:text-ink-dark/75 px-4 py-2 rounded-lg hover:text-ink dark:hover:text-ink-dark hover:bg-ink/[.04] dark:hover:bg-ink-dark/[.05] transition-all duration-150">Work</a>
      <a href="/about" class="font-ui text-[16px] font-medium text-ink/70 dark:text-ink-dark/75 px-4 py-2 rounded-lg hover:text-ink dark:hover:text-ink-dark hover:bg-ink/[.04] dark:hover:bg-ink-dark/[.05] transition-all duration-150">About</a>
      <button id="theme-toggle" aria-label="Toggle dark mode" class="w-9 h-9 rounded-lg flex items-center justify-center text-ink/40 dark:text-ink-dark/50 hover:text-ink dark:hover:text-ink-dark hover:bg-ink/[.04] dark:hover:bg-ink-dark/[.05] transition-all duration-150 ml-1">
        <svg class="w-5 h-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      </button>
      <a href="mailto:ananyarao121996@gmail.com" class="font-ui text-[15px] font-medium bg-ink dark:bg-ink-dark text-pagebg dark:text-pagebg-dark px-5 py-2.5 rounded-full hover:opacity-85 transition-opacity duration-200 ml-3">Contact</a>
    </nav>
  </div>
</header>
<script is:inline>
  document.getElementById('theme-toggle').addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
  });
</script>
