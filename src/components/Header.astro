---
import { SITE } from "../consts";
import type { Lang } from "../i18n";
import { t, localizePath } from "../i18n";

interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const tr = t(lang);

const nav = [
  { label: tr.nav.about, href: localizePath(lang, "/about") },
  { label: tr.nav.caseStudies, href: localizePath(lang, "/blog") },
  { label: tr.nav.insights, href: localizePath(lang, "/work") },
];

// Equivalent page in the other language; detail pages fall back to their
// section index, unknown paths to home.
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const basePath = lang === "de" ? (pathname.replace(/^\/de/, "") || "/") : pathname;
const localizedRoots = ["/", "/blog", "/work", "/about", "/impressum"];
const switchBase = localizedRoots.includes(basePath)
  ? basePath
  : localizedRoots.find((r) => r !== "/" && basePath.startsWith(r)) ?? "/";
const switchHref = lang === "de" ? switchBase : localizePath("de", switchBase);
---
<header class="fixed top-0 left-0 right-0 z-50 bg-pagebg/90 dark:bg-pagebg-dark/90 backdrop-blur-md border-b border-ink/15 dark:border-ink-dark/15">
  <div class="wrap flex items-center justify-between h-[72px]">
    <a href={localizePath(lang, "/")} class="font-display font-semibold text-[1.4rem] text-ink dark:text-ink-dark leading-tight hover:opacity-70 transition-opacity">{SITE.name}</a>
    <nav class="flex items-center gap-1">
      {nav.map(item => (
        <a href={item.href} class="hidden sm:inline font-ui text-[13px] font-medium uppercase tracking-[.16em] text-muted dark:text-muted-dark px-3 py-2 hover:text-ink dark:hover:text-ink-dark transition-colors duration-150">{item.label}</a>
      ))}
      <button data-contact-trigger class="font-ui text-[13px] font-medium uppercase tracking-[.16em] text-muted dark:text-muted-dark px-3 py-2 hover:text-ink dark:hover:text-ink-dark transition-colors duration-150 cursor-pointer">{tr.nav.contact}</button>
      <a href={switchHref} class="font-ui text-[13px] font-medium uppercase tracking-[.16em] border border-ink/20 dark:border-ink-dark/25 text-ink dark:text-ink-dark px-3 py-2 ml-2 hover:border-ink dark:hover:border-ink-dark transition-colors duration-150" aria-label={lang === "de" ? "Switch to English" : "Zu Deutsch wechseln"}>
        {lang === "de" ? "EN" : "DE"}
      </a>
      <button id="theme-toggle" class="font-ui text-[13px] font-semibold uppercase tracking-[.14em] bg-ink dark:bg-ink-dark text-pagebg dark:text-pagebg-dark px-4 py-2 ml-2 hover:opacity-80 transition-opacity duration-150">
        <span class="dark:hidden">Light ⇄</span>
        <span class="hidden dark:inline">Dark ⇄</span>
      </button>
    </nav>
  </div>
</header>
<script is:inline>
  document.getElementById('theme-toggle').addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
  });
</script>
